# ============================================================
# PortLev Academy — environment variables
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and never committed.
# ============================================================

# ---- beehiiv (Leverage Brief newsletter) ----
# Get these from beehiiv Settings > API Keys and your publication ID.
BEEHIIV_API_KEY=your_beehiiv_api_key_here
BEEHIIV_PUBLICATION_ID=pub_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ---- Site URL (used for sitemap, RSS, OG images) ----
# No trailing slash. Use https in production.
NEXT_PUBLIC_SITE_URL=https://learn.portlev.com

# ---- Skool community links (shown in nav and CTAs) ----
NEXT_PUBLIC_SKOOL_FREE_URL=https://www.skool.com/your-free-community
NEXT_PUBLIC_SKOOL_PAID_URL=https://www.skool.com/leverage-lab

# ---- Maven cohort URL (shown on cohort landing page) ----
NEXT_PUBLIC_MAVEN_COHORT_URL=https://maven.com/portlev/chro-ai-cohort
